--- !u!114 &455112152
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 455112151}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe482e72c4c354a5bbf3ed1a742a4bb0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialDirector
  steps:
  - startX: -999
    title: CAMINAR Y MIRAR
    useCheckpoint: 0
    checkpointX: 0
    hint: "Usa  W A S D  para caminar y mueve el  RAT\xD3N  para mirar"
  - startX: -3
    title: CORRER
    useCheckpoint: 1
    checkpointX: -3
    hint: "Mant\xE9n  SHIFT  mientras caminas para correr"
  - startX: 6.5
    title: SALTAR
    useCheckpoint: 1
    checkpointX: 7
    hint: "\xA1Un obst\xE1culo! Pulsa  ESPACIO  para saltarlo"
  - startX: 12
    title: AGACHARSE
    useCheckpoint: 1
    checkpointX: 14
    hint: "El techo es bajo: mant\xE9n  C  (o CTRL) para pasar agachado"
  - startX: 20.099998
    title: "\xA1CUIDADO, TRAMPAS!"
    useCheckpoint: 1
    checkpointX: 23.199999
    hint: "Si pisas un cepo pierdes una vida. Esqu\xEDvalos por los lados"
  - startX: 30
    title: LLAVE Y PUERTA
    useCheckpoint: 1
    checkpointX: 30.3
    hint: Recoge la llave y pulsa  E  junto a la puerta para abrirla
  finishX: 37
  finishTitle: "\xA1TUTORIAL COMPLETADO!"
  finishHint: "Ahora s\xED... a rescatar a tu gato. Cuidado: nada es lo que parece."
  checkpointZ: -0.8585
